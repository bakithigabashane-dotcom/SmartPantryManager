
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="#F7F5EF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#315B45"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your kitchen, organised."
        android:textSize="14sp"
        android:textColor="#657568"
        android:paddingBottom="14dp" />

    <EditText
        android:id="@+id/ingredientName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="12dp"
        android:backgroundTint="#8BA995"
        android:hint="Ingredient name"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:textColor="#26382D"
        android:textColorHint="#7A887D" />

    <EditText
        android:id="@+id/ingredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="12dp"
        android:backgroundTint="#8BA995"
        android:hint="Quantity (e.g. 2)"
        android:inputType="numberDecimal"
        android:singleLine="true"
        android:textColor="#26382D"
        android:textColorHint="#7A887D" />

    <EditText
        android:id="@+id/ingredientUnit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="12dp"
        android:backgroundTint="#8BA995"
        android:hint="Unit (e.g. kg, items, cups)"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="#26382D"
        android:textColorHint="#7A887D" />

    <TextView
        android:id="@+id/expiryDateInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#E5EDE5"
        android:text="Expiry date: Not set"
        android:textSize="15sp"
        android:textColor="#315B45"
        android:clickable="true"
        android:focusable="true" />

    <Button
        android:id="@+id/addIngredientButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="6dp"
        android:text="Add Ingredient"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#416B50" />

    <Button
        android:id="@+id/findRecipesButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:text="Find Recipes"
        android:textAllCaps="false"
        android:textColor="#315B45"
        android:backgroundTint="#DCE8DC" />

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Settings"
        android:textAllCaps="false"
        android:textColor="#315B45"
        android:backgroundTint="#DCE8DC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#315B45"
        android:paddingTop="14dp"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/pantryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="4dp"
        android:divider="#E3E9E2"
        android:dividerHeight="1dp"
        android:clipToPadding="false" />

</LinearLayout>
